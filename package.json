{
  "name": "tequitl",
  "version": "1.0.1",
  "description": "TEQUITL - Suite de Productividad Neo-Brutalista con Electron",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:win": "tsc && vite build && electron-builder --win",
    "build:linux": "tsc && vite build && electron-builder --linux",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "build:all": "tsc && vite build && electron-builder --win --linux --mac",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.tequitl.app",
    "productName": "TEQUITL",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*",
      "frases.json"
    ],
    "asarUnpack": [
      "resources/sql-wasm.wasm"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/logo.ico"
    },
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "category": "Office",
      "synopsis": "Suite de Productividad Neo-Brutalista"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/logo.png",
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/logo.ico",
      "uninstallerIcon": "resources/logo.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "MHAlberto",
      "repo": "Tequitl"
    }
  }
}
